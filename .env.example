APP_NAME="Monitor de Procesos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ─── Inteligencia Artificial & RAG ───────────────────────────────────────────
ALERT_AI_PROVIDER=openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
ALERT_AI_OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=your-api-key-here
IA_KEYWORD_DETECTION_ENABLED=false

IA_RAG_ENABLED=false

IA_RAG_BASE_URL=http://localhost:8000
IA_RAG_TIMEOUT=120
IA_RAG_TASK_MAX_ATTEMPTS=60
IA_RAG_TASK_RETRY_DELAY=2
IA_RAG_SYNC_QUEUE=process-sync

# ─── Configuración de Aplicación ──────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Base de Datos ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=judicial_filings
DB_USERNAME=root
DB_PASSWORD=

# ─── Sesión & Caché ──────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Minutos de inactividad antes de bloquear la sesión en el frontend (3–60 min)
SESSION_LOCK_TIMEOUT_MINUTES=5

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Horizon + Log Viewer (mismo token: /horizon?token=... y /log-viewer?token=...)
HORIZON_SECRET=
HORIZON_ALLOWED_EMAILS=
LOG_VIEWER_ENABLED=true
# Forge producción (logs fuera de releases, sobreviven al deploy):
# LOG_VIEWER_LOGS_PATH=/home/forge/backend.notijudicial.com/storage/logs
# LOG_VIEWER_API_STATEFUL_DOMAINS=backend.notijudicial.com

# ─── Notificaciones en Tiempo Real (Reverb) ──────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${VITE_REVERB_PORT}"
VITE_REVERB_SCHEME="${VITE_REVERB_SCHEME}"

# ─── Correo Electrónico (SMTP) ───────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
SUPPORT_EMAIL=soporte@example.com

# Mailgun API (For Batch Judicial Notifications)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# ─── Rama Judicial API & Configuración de Scraper ────────────────────────────
JUDICIAL_BRANCH_API_URL=https://consultaprocesos.ramajudicial.gov.co:448/api/v2
ADMIN_PROCESS_IMPORT_REPORT_EMAIL=admin@example.com
ADMIN_PRIVACY_TRANSITION_EMAIL=
# Registro AppUser: respuesta síncrona completa si cada instancia nueva tiene como máximo N páginas de actuaciones; si alguna supera N, el alta va en cola.
JUDICIAL_BRANCH_REGISTRATION_INLINE_MAX_ACTUACION_PAGES=2

# ─── SAMAI (Consejo de Estado) ────────────────────────────────────────────────
SAMAI_API_URL=https://samaicore.consejodeestado.gov.co/api
SAMAI_MODO=2
SAMAI_API_KEY=
SAMAI_TIMEOUT=15
SAMAI_DISCOVERY_TIMEOUT=60
SAMAI_REGISTRATION_INLINE_MAX_ACTUACIONES=50

# Fallback HTML para actuaciones y sujetos cuando no hay SAMAI_API_KEY.
SAMAI_PUBLIC_PORTAL_ENABLED=true
SAMAI_PUBLIC_PORTAL_URL=https://samai.consejodeestado.gov.co
SAMAI_PUBLIC_PORTAL_TIMEOUT=60
SAMAI_PUBLIC_PORTAL_CONNECT_TIMEOUT=15
SAMAI_PUBLIC_PORTAL_MAX_ATTEMPTS=3
SAMAI_PUBLIC_PORTAL_USER_AGENT="Mozilla/5.0 (compatible; NotiJudicial/1.0)"

# ─── Configuración de Proxies Residenciales (ProxyScrape) ────────────────────
# HTTPS en puerto no estándar (448): los gateways HTTP suelen abortar CONNECT (cURL 56).
# Usar SOCKS5 y el host/puerto que indique el panel de ProxyScrape para residential SOCKS5.
JUDICIAL_BRANCH_PROXY_ENABLED=false
JUDICIAL_BRANCH_PROXY_PROVIDER=proxyscrape
JUDICIAL_BRANCH_PROXY_PROTOCOL=http
JUDICIAL_BRANCH_PROXY_HOST=
JUDICIAL_BRANCH_PROXY_PORT=6060
# Ejemplo SOCKS5 (confirmar host/puerto en el dashboard):
# JUDICIAL_BRANCH_PROXY_PROTOCOL=socks5
# JUDICIAL_BRANCH_PROXY_HOST=rp.proxyscrape.com
# JUDICIAL_BRANCH_PROXY_PORT=7070
JUDICIAL_BRANCH_PROXY_USERNAME=
JUDICIAL_BRANCH_PROXY_PASSWORD=
JUDICIAL_BRANCH_PROXY_TIMEOUT=60
JUDICIAL_BRANCH_PROXY_ENABLE_SESSION_MUTATION=false
JUDICIAL_BRANCH_PROXY_MAX_CONNECTION_RETRIES=2
JUDICIAL_BRANCH_PROXY_CONNECTION_RETRY_BASE_MS=700
JUDICIAL_BRANCH_PROXY_CONNECTION_CIRCUIT_BREAKER_MS=3000

# Jitter Dinámico para evasión de WAF (Cloudflare)
JUDICIAL_BRANCH_PROXY_CALL_DELAY_MIN_MS=1000
JUDICIAL_BRANCH_PROXY_CALL_DELAY_MAX_MS=2500
JUDICIAL_SYNC_INACTIVE_SKIP_DAYS=2

# ─── Optimización de Importación Masiva (Jobs & Retries) ──────────────────────
PROCESS_IMPORT_TRIES=120
PROCESS_IMPORT_DELAY_SECONDS=1
PROCESS_IMPORT_RATE_LIMIT_PER_MINUTE=4

# Configuración de Colas por Canal de Notificación
NOTIFICATION_INTERNAL_QUEUE=notifications
NOTIFICATION_EMAIL_QUEUE=notifications-email
NOTIFICATION_SMS_QUEUE=notifications-sms
NOTIFICATION_WHATSAPP_QUEUE=notifications-whatsapp

# Configuración de Reintentos según el tipo de fallo
PROCESS_IMPORT_RETRY_MAX_ATTEMPTS=5
PROCESS_IMPORT_RETRY_RELEASE_SECONDS=60

# Especial para Rate Limit (Bloqueo de IP del Proxy)
PROCESS_IMPORT_RETRY_MAX_ATTEMPTS_RATE_LIMIT=10
PROCESS_IMPORT_RETRY_RELEASE_RATE_LIMIT_PROXY=5
PROCESS_IMPORT_RETRY_RELEASE_RATE_LIMIT=120

# Escenarios de "No encontrado" o "Respuesta Vacía" (transitorios)
PROCESS_IMPORT_RETRY_MAX_ATTEMPTS_NOT_FOUND=5
PROCESS_IMPORT_RETRY_RELEASE_SECONDS_NOT_FOUND=60
PROCESS_IMPORT_RETRY_MAX_ATTEMPTS_EMPTY=3
PROCESS_IMPORT_RETRY_RELEASE_SECONDS_EMPTY=120

# ─── Servicios en la Nube ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Notificaciones ────────────────────────────────────────────────────
FRONTEND_URL_EMAIL_CONSOLIDATED=
FRONTEND_DIGEST_PATH=/notification-digests
DIGEST_EMAIL_MAX_ROWS=0
DIGEST_EMAIL_TABLE_WIDTH=1280

# Discord (spatie/laravel-discord-alerts) — webhooks por canal. Vacío = no envía.
# #log-sync-daily — informes al terminar judicial:sync-processes
# #sincronizacion-tardia — radicados con fecha de replicación atrasada en Rama
DISCORD_ALERT_WEBHOOK=
DISCORD_ALERT_WEBHOOK_LOG_SYNC_DAILY=
DISCORD_ALERT_WEBHOOK_LATE_SYNC=
DISCORD_ALERT_QUEUE=default

JUDICIAL_SYNC_AUTO_DIGEST=true
JUDICIAL_SYNC_REPLICATION_STALENESS_ENABLED=true
JUDICIAL_SYNC_REPLICATION_STALE_HOURS=24
JUDICIAL_SYNC_REPLICATION_STALE_EXCLUDE_WEEKENDS=true
JUDICIAL_SYNC_REPLICATION_STALE_EXCLUDE_HOLIDAYS=true
