APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REVERB_APP_ID=534721
REVERB_APP_KEY=judicial_reverb_key
REVERB_APP_SECRET=judicial_reverb_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Rama Judicial API ───────────────────────────────────────────────────────
JUDICIAL_BRANCH_API_URL=
# JUDICIAL_BRANCH_TIMEOUT_SECONDS=60
# Límite de llamadas HTTP individuales por minuto (búsqueda + detalle + actuaciones + sujetos).
# Fórmula: PROCESS_IMPORT_RATE_LIMIT_PER_MINUTE × 4 llamadas/radicado.
# Con 4 radicados/min → 16. Bajar si la API sigue devolviendo 403 con frecuencia.
JUDICIAL_BRANCH_RATE_LIMIT_PER_MINUTE=16

# ─── Process import ──────────────────────────────────────────────────────────
ADMIN_PROCESS_IMPORT_REPORT_EMAIL=
# Radicados que se procesan por minuto (límite de radicados completos, no de llamadas HTTP).
PROCESS_IMPORT_RATE_LIMIT_PER_MINUTE=4
# Delay entre radicados (segundos). Regla: ceil(60 / PROCESS_IMPORT_RATE_LIMIT_PER_MINUTE).
# Con limit=4 → 15s → 138 radicados ≈ 35 minutos.
PROCESS_IMPORT_DELAY_SECONDS=15
# PROCESS_IMPORT_RETRY_RELEASE_SECONDS=120
# PROCESS_IMPORT_RETRY_MAX_ATTEMPTS=2
# Segundos base de espera al recibir 403/429 (se suma jitter de hasta 25s adicionales).
# PROCESS_IMPORT_RETRY_RELEASE_RATE_LIMIT=180
# Reintentos para radicado no encontrado (puede ser transitorio). Recomendado: 3.
# Valores altos (ej. 30) hacen que radicados inexistentes reintentos durante horas.
# PROCESS_IMPORT_RETRY_MAX_ATTEMPTS_NOT_FOUND=3
# PROCESS_IMPORT_RETRY_RELEASE_SECONDS_NOT_FOUND=300
# Reintentos para 200 OK con array vacío (Rama Judicial bajo carga). Recomendado: 3.
# PROCESS_IMPORT_RETRY_MAX_ATTEMPTS_EMPTY=3
# PROCESS_IMPORT_RETRY_RELEASE_SECONDS_EMPTY=120

# ─── Proxy Pool ───────────────────────────────────────────────────────────────
# Activar rotación de IPs para importación masiva (evita rate limit por IP).
# Con proxies activos, PROCESS_IMPORT_DELAY_SECONDS debe ser ≥ 3.
# JUDICIAL_BRANCH_PROXY_ENABLED=false

# Proveedor: "proxyscrape" (datacenter, 1000 IPs) o "geonode" (gratuito, ~500 IPs)
# JUDICIAL_BRANCH_PROXY_PROVIDER=proxyscrape

# URL ProxyScrape — respuesta: texto plano ip:port por línea
# JUDICIAL_BRANCH_PROXY_PROXYSCRAPE_URL=https://api.proxyscrape.com/v2/account/datacenter_shared/proxy-list?auth=TU_TOKEN&type=getproxies&country[]=all&protocol=http&format=normal&status=all

# URL Geonode — respuesta: JSON { data: [ { ip, port } ] }
# JUDICIAL_BRANCH_PROXY_GEONODE_URL=https://proxylist.geonode.com/api/proxy-list?protocols=http&limit=500&page=1&sort_by=lastChecked&sort_type=desc

# TTL de caché del pool en minutos (default: 60)
# JUDICIAL_BRANCH_PROXY_CACHE_TTL_MINUTES=60

# Alert AI: detección de palabras clave en actuaciones (openai | ollama)
# ALERT_AI_PROVIDER=openai
# OPENAI_API_KEY=                    # si provider=openai
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# ALERT_AI_OLLAMA_MODEL=llama3.2:3b
# ALERT_AI_OLLAMA_TIMEOUT=60
